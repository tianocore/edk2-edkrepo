<ui:FluentWindow x:Class="TianoCore.EdkMingwInstaller.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Edk2Clang Installer" Height="370" Width="503" MinHeight="370" MinWidth="503" ResizeMode="CanMinimize" Background="{DynamicResource ApplicationBackgroundBrush}" Icon="SetupIcon.ico" WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
        SourceInitialized="Window_SourceInitialized" ContentRendered="Window_ContentRendered">
    <!--
    @file
      ProgressWindow.xaml

    @copyright
      Copyright 2025 - 2026 Intel Corporation. All rights reserved.<BR>
      SPDX-License-Identifier: BSD-2-Clause-Patent
    -->
    <Grid Name="WindowGrid">
        <Grid Name="RootGrid" Margin="24,48,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="HeaderGrid_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="InstallingLabel" Text="Installing EdkRepo" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ProgressBar x:Name="InstallProgress" Grid.Row="0" Height="4" IsIndeterminate="True" Margin="0,0,0,16"/>
                <ui:InfoBar x:Name="ResultInfoBar" Grid.Row="0" IsOpen="False" IsClosable="False" Margin="0,0,0,8"/>
                <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="8">
                    <ScrollViewer x:Name="ProgressTextScrollViewer"
                            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBox x:Name="ProgressTextBox" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" AllowDrop="False" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <ui:Button x:Name="ActionButton" Content="Cancel" Width="104" Click="ActionButton_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
        <ui:TitleBar Title="" Height="40" Background="Transparent" VerticalAlignment="Top" ShowMaximize="False" ShowClose="False"/>
    </Grid>
</ui:FluentWindow>

