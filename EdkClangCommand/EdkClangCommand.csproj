  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{247F6563-35D1-4677-8639-69AA284351A5}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>TianoCore.EdkClang</RootNamespace>
    <AssemblyName>edkclang-core</AssemblyName>
    <TargetFrameworkVersion>v4.6.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <WarningLevel>4</WarningLevel>
    <TargetFrameworkProfile />
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <!-- Reference assembly only. At run time this binds to the copy in Windows PowerShell 5.1 (GAC). -->
    <Reference Include="System.Management.Automation">
      <HintPath>..\lib\PowerShellStandard\System.Management.Automation.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Common\EdkClangLayout.cs">
      <Link>Common\EdkClangLayout.cs</Link>
    </Compile>
    <Compile Include="PowerShellPipe.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="ShellDetector.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.manifest" />
    <None Include="edkclang.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="edkclang.sh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!--
    Development convenience: puts the loose files next to the installer exe, where the installer
    looks for them. build_installer.bat packages them into the self-extracting installer.
    The package tools folder mirrors the tools folder that the installer creates in the installation directory.
  -->
  <Target Name="CopyToInstallerOutput" AfterTargets="Build">
    <MakeDir Directories="..\EdkMingwInstaller\bin\$(Configuration)\tools" />
    <Copy SourceFiles="$(OutDir)edkclang-core.exe;$(OutDir)edkclang.cmd" DestinationFolder="..\EdkMingwInstaller\bin\$(Configuration)\tools" />
    <Copy SourceFiles="$(OutDir)edkclang.sh" DestinationFolder="..\EdkMingwInstaller\bin\$(Configuration)" />
  </Target>
</Project>
